# =====================================================================
#  TradingView Clone - backend configuration
#  1. Copy this file to "backend\.env"   (PowerShell: Copy-Item .env.example .env)
#  2. Fill in the values on the line BELOW each "<-- YOU FILL" comment
#  3. Never put a comment on the same line as a value
#  4. Never commit .env to git (it is already in .gitignore)
# =====================================================================

# ---------------------------------------------------------------------
# App / server
# ---------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# true = auto-restart when you edit Python files (development only)
UVICORN_RELOAD=false
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Relative paths are resolved from the backend folder
LOG_DIR=logs
# Frontend dev-server origins allowed to call the API (Phase 2 uses Vite on 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------
# Comma-separated list. Available: simulated, mt5, oanda, auto
#   auto = MT5 with automatic fallback to OANDA when MT5 is offline
#          (needs mt5 AND oanda in this list too)
# Until MT5/OANDA are set up you can use:  ENABLED_PROVIDERS=simulated
ENABLED_PROVIDERS=simulated,mt5,oanda,auto
# Provider used by REST calls that do not pass ?provider=
DEFAULT_PROVIDER=auto
HISTORY_DEFAULT_BARS=500
HISTORY_MAX_BARS=5000

# ---------------------------------------------------------------------
# MetaTrader 5  (Windows only)
# ---------------------------------------------------------------------
# <-- YOU FILL (recommended)
# Full path to terminal64.exe. Leave empty to let MT5 auto-detect the
# default installation. Typical locations:
#   C:\Program Files\MetaTrader 5\terminal64.exe
#   C:\Program Files\<Broker Name> MetaTrader 5\terminal64.exe
# IMPORTANT: write the path WITHOUT double quotes (quotes turn "\t" into a TAB).
# Example:  MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# OPTIONAL: leave all three empty to use the account you are already
# logged into inside the MT5 terminal (simplest).
# If you fill them, fill ALL three.
# <-- YOU FILL (optional) account number, digits only
MT5_LOGIN=
# <-- YOU FILL (optional)
MT5_PASSWORD=
# <-- YOU FILL (optional) exactly as shown in MT5, e.g. MetaQuotes-Demo
MT5_SERVER=

MT5_TIMEOUT_MS=60000
# true only if you installed MT5 in portable mode
MT5_PORTABLE=false
# How often the bridge reads new ticks from MT5 (milliseconds)
MT5_POLL_INTERVAL_MS=100
# Max wait between automatic reconnect attempts (seconds)
MT5_RECONNECT_MAX_DELAY_S=30
# Hours between your broker's MT5 server clock and UTC (usually 2 or 3).
# Leave empty to auto-detect from live ticks (recommended). Used to line up
# OANDA fallback candles with MT5 candles.
MT5_SERVER_UTC_OFFSET_HOURS=

# ---------------------------------------------------------------------
# OANDA  (fallback data source - free practice account)
# ---------------------------------------------------------------------
# <-- YOU FILL  personal access token from OANDA (see FAILOVER.md, Step 1)
OANDA_API_TOKEN=
# Optional: leave empty to use the first account on the token
OANDA_ACCOUNT_ID=
# practice (demo account, free) or live
OANDA_ENVIRONMENT=practice
# Optional extra symbol mappings MT5NAME=OANDA_NAME, comma-separated
# Example: OANDA_SYMBOL_MAP=GER40=DE30_EUR,USTEC=NAS100_USD
OANDA_SYMBOL_MAP=
OANDA_REQUEST_TIMEOUT_S=15
OANDA_RECONNECT_MAX_DELAY_S=30

# ---------------------------------------------------------------------
# Failover ("auto" provider)
# ---------------------------------------------------------------------
FAILOVER_PRIMARY=mt5
FAILOVER_FALLBACK=oanda
# Seconds MT5 must stay connected before data switches back from OANDA
FAILOVER_SWITCH_BACK_DELAY_S=15

# ---------------------------------------------------------------------
# Simulator (works everywhere, no account needed)
# ---------------------------------------------------------------------
SIM_TICK_INTERVAL_MS=250

# ---------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------
# Max queued messages per browser tab before the oldest are dropped
WS_CLIENT_QUEUE_SIZE=2000

# =====================================================================
#  FUTURE PHASES - not read by the Phase 1 code yet. Safe to leave empty.
# =====================================================================
# Phase 3 - persistence
DATABASE_URL=sqlite:///./data/tradingview.db

# Phase 4 - Indian broker (fill the block for the broker you choose)
BROKER=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/broker/upstox/callback
KITE_API_KEY=
KITE_API_SECRET=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=

# Phase 5 - Notion trade journal
NOTION_API_KEY=
NOTION_DATABASE_ID=
